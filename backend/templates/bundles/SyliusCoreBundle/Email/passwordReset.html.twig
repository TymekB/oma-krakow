{% extends '@SyliusCore/Email/layout.html.twig' %}

{% block subject %}
    {{ 'sylius.email.password_reset.subject'|trans({}, null, localeCode)|raw }}
{% endblock %}

{% block content %}
    {% import 'email/_components.html.twig' as oma %}

    {% set shop_loaded = sylius_bundle_loaded_checker('SyliusShopBundle') %}

    {{ oma.greeting('sylius.email.password_reset.hello'|trans({}, null, localeCode), user.username) }}

    {% if shop_loaded %}
        {{ oma.lead('sylius.email.password_reset.to_reset_your_password'|trans({}, null, localeCode)) }}

        <div style="text-align: center;">
            {{ oma.button(url('sylius_shop_password_reset', { 'token': user.passwordResetToken, '_locale': localeCode }), 'sylius.email.password_reset.reset_your_password'|trans({}, null, localeCode)) }}
        </div>
    {% else %}
        {{ oma.lead('sylius.email.password_reset.to_reset_your_password_token'|trans({}, null, localeCode)) }}
        {{ oma.token('sylius.email.password_reset.token'|trans({}, null, localeCode), user.passwordResetToken) }}
    {% endif %}
{% endblock %}
