{% extends '@SyliusCore/Email/layout.html.twig' %}

{% block subject %}
    {{ 'sylius.email.admin_password_reset.subject'|trans({}, null, localeCode)|raw }}
{% endblock %}

{% block content %}
    {% import 'email/_components.html.twig' as oma %}

    {% set admin_loaded = sylius_bundle_loaded_checker('SyliusAdminBundle') %}

    {{ oma.greeting('sylius.email.admin_password_reset.hello'|trans({}, null, localeCode), adminUser.firstName ~ ' ' ~ adminUser.lastName) }}

    {% if admin_loaded %}
        {{ oma.lead('sylius.email.password_reset.to_reset_your_password'|trans({}, null, localeCode)) }}

        <div style="text-align: center;">
            {{ oma.button(url('sylius_admin_render_password_reset', {'token': adminUser.passwordResetToken}), 'sylius.email.admin_password_reset.reset_your_password'|trans({}, null, localeCode)) }}
        </div>
    {% else %}
        {{ oma.lead('sylius.email.admin_password_reset.to_reset_your_password_token'|trans({}, null, localeCode)) }}
        {{ oma.token('sylius.email.admin_password_reset.token'|trans({}, null, localeCode), adminUser.passwordResetToken) }}
    {% endif %}
{% endblock %}
