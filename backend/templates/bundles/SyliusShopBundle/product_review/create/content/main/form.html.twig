{% import '@SyliusShop/shared/macro/loader.html.twig' as loader %}
{% import _self as summary %}

{% macro messages(field) %}
    {% import _self as summary %}

    {% for error in field.vars.errors %}
        <li>{{ error.message }}</li>
    {% endfor %}

    {% for child in field %}
        {{ summary.messages(child) }}
    {% endfor %}
{% endmacro %}

{% form_theme form '@SyliusShop/form/theme.html.twig' %}

<div {{ attributes }} class="mb-4 position-relative">
    {{ loader.render() }}
    {{ form_start(form, {'attr': {'novalidate': 'novalidate'}}) }}

    {% set problems = summary.messages(form)|trim %}

    {% if problems is not empty %}
        <div class="alert alert-danger" role="alert" data-oma-review-errors>
            <strong>{{ 'oma.review.form_has_errors'|trans }}</strong>
            <ul class="mb-0">{{ problems|raw }}</ul>
        </div>
    {% endif %}

    {% hook 'form' with { form } %}

    {{ form_end(form, {'render_rest': false}) }}
</div>
