{% import "@SyliusShop/shared/macro/money.html.twig" as money %}

{% set order = hookable_metadata.context.order %}

<tr>
    <td class="border-top pt-4 oma-summary-total">{{ 'sylius.ui.order_total'|trans }}:</td>
    <td id="sylius-shop-checkout-summary-order-total" class="border-top pt-4 text-end oma-summary-total">{{ money.convertAndFormat(order.total) }}</td>
</tr>
