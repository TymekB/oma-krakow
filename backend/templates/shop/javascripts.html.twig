{{ encore_entry_script_tags('app-shop-entry', null, 'app.shop', { 'data-turbo-eval': 'false' }) }}

<script>
    (function () {
        if (window.omaApplePayGuard) {
            return;
        }

        window.omaApplePayGuard = true;

        var APPLE_PAY_METHOD_CODE = 'payu_apple_pay';

        function applePayAvailable() {
            try {
                return typeof window.ApplePaySession !== 'undefined' && window.ApplePaySession.canMakePayments();
            } catch (error) {
                return false;
            }
        }

        function hideApplePay() {
            if (applePayAvailable()) {
                return;
            }

            document.querySelectorAll('input[type="radio"][value="' + APPLE_PAY_METHOD_CODE + '"]').forEach(function (input) {
                var choice = input.closest('.card') || input.parentElement;

                if (!choice) {
                    return;
                }

                choice.hidden = true;

                if (!input.checked) {
                    return;
                }

                input.checked = false;

                var fallback = document.querySelector('input[type="radio"][name="' + input.name + '"]:not([value="' + APPLE_PAY_METHOD_CODE + '"])');

                if (fallback) {
                    fallback.checked = true;
                }
            });
        }

        document.addEventListener('DOMContentLoaded', hideApplePay);
        document.addEventListener('turbo:load', hideApplePay);
        document.addEventListener('turbo:frame-render', hideApplePay);
    })();
</script>
