<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edycja strony — OMA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --wine-800: #5a1f2c;
            --wine-600: #8a3746;
            --paper: #f4f3f0;
            --paper-line: #dcd9d4;
            --ink: #2a2320;
            --ink-soft: #6f6259;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: 'Jost', 'Helvetica Neue', Arial, sans-serif;
            font-weight: 300;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .site-edit__bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.9rem 1.5rem;
            background: #fff;
            border-bottom: 1px solid var(--paper-line);
        }

        .site-edit__title {
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-size: 1.4rem;
            color: var(--wine-800);
            margin: 0;
        }

        .site-edit__hint {
            font-size: 0.78rem;
            color: var(--ink-soft);
        }

        .site-edit__frame {
            flex: 1;
            width: 100%;
            border: 0;
            background: var(--paper);
        }

        .site-edit__actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 1rem;
            padding: 1rem 1.5rem;
            background: #fff;
            border-top: 1px solid var(--paper-line);
        }

        .site-edit__status {
            font-size: 0.82rem;
            color: var(--ink-soft);
            margin-right: auto;
        }

        .site-edit__btn {
            font: inherit;
            cursor: pointer;
            padding: 0.75rem 2rem;
            border-radius: 2rem;
            border: 1px solid var(--wine-800);
            background: var(--wine-800);
            color: var(--paper);
            font-size: 0.78rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
        }

        .site-edit__btn:hover:not(:disabled) { background: var(--wine-600); border-color: var(--wine-600); }
        .site-edit__btn:disabled { opacity: 0.45; cursor: not-allowed; }

        .site-edit__btn--ghost { background: transparent; color: var(--wine-800); }
        .site-edit__btn--ghost:hover:not(:disabled) { background: var(--wine-800); color: var(--paper); }
    </style>
</head>
<body>
    <div class="site-edit__bar">
        <h1 class="site-edit__title">Edycja strony</h1>
        <span class="site-edit__hint">Kliknij dowolny tekst, popraw treść, a na końcu zapisz zmiany.</span>
        <a class="site-edit__btn site-edit__btn--ghost" href="{{ path('sylius_admin_dashboard') }}">Wróć do panelu</a>
    </div>

    <iframe id="site-frame" class="site-edit__frame" src="/?edit=1" title="Podgląd strony"></iframe>

    <div class="site-edit__actions">
        <span class="site-edit__status" id="status">Brak zmian do zapisania.</span>
        <button type="button" class="site-edit__btn site-edit__btn--ghost" id="discard" disabled>Odrzuć zmiany</button>
        <button type="button" class="site-edit__btn" id="save" disabled>Zapisz zmiany</button>
    </div>

    <script>
        const frame = document.getElementById('site-frame');
        const status = document.getElementById('status');
        const saveButton = document.getElementById('save');
        const discardButton = document.getElementById('discard');

        const setDirty = (count) => {
            const hasChanges = count > 0;
            saveButton.disabled = !hasChanges;
            discardButton.disabled = !hasChanges;
            status.textContent = hasChanges
                ? `Niezapisane zmiany: ${count}`
                : 'Brak zmian do zapisania.';
        };

        window.addEventListener('message', (event) => {
            if (event.source !== frame.contentWindow) {
                return;
            }

            const message = event.data ?? {};

            if (message.type === 'oma:dirty') {
                setDirty(message.count ?? 0);
            }

            if (message.type === 'oma:saved') {
                status.textContent = message.ok ? 'Zapisano zmiany.' : 'Nie udało się zapisać zmian.';
                saveButton.disabled = message.ok;
                discardButton.disabled = message.ok;
            }
        });

        saveButton.addEventListener('click', () => {
            status.textContent = 'Zapisywanie…';
            frame.contentWindow.postMessage({ type: 'oma:save' }, window.location.origin);
        });

        discardButton.addEventListener('click', () => {
            frame.contentWindow.postMessage({ type: 'oma:discard' }, window.location.origin);
        });
    </script>
</body>
</html>
