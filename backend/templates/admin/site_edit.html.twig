<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Edycja strony — OMA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --wine-800: #5a1f2c;
            --wine-600: #8a3746;
            --paper: #f4f3f0;
            --paper-line: #dcd9d4;
            --ink: #2a2320;
            --ink-soft: #6f6259;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: 'Jost', 'Helvetica Neue', Arial, sans-serif;
            font-weight: 300;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .site-edit__bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.9rem 1.5rem;
            background: #fff;
            border-bottom: 1px solid var(--paper-line);
        }

        .site-edit__title {
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-size: 1.4rem;
            color: var(--wine-800);
            margin: 0;
        }

        .site-edit__hint {
            font-size: 0.78rem;
            color: var(--ink-soft);
        }

        .site-edit__frame {
            flex: 1;
            width: 100%;
            border: 0;
            background: var(--paper);
        }

        .site-edit__actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 1rem;
            padding: 1rem 1.5rem;
            background: #fff;
            border-top: 1px solid var(--paper-line);
        }

        .site-edit__status {
            font-size: 0.82rem;
            color: var(--ink-soft);
            margin-right: auto;
        }

        .site-edit__btn {
            font: inherit;
            cursor: pointer;
            padding: 0.75rem 2rem;
            border-radius: 2rem;
            border: 1px solid var(--wine-800);
            background: var(--wine-800);
            color: var(--paper);
            font-size: 0.78rem;
            letter-spacing: 0.18em;
            text-transform: uppercase;
        }

        .site-edit__btn:hover:not(:disabled) { background: var(--wine-600); border-color: var(--wine-600); }
        .site-edit__btn:disabled { opacity: 0.45; cursor: not-allowed; }

        .site-edit__btn--ghost { background: transparent; color: var(--wine-800); }
        .site-edit__btn--ghost:hover:not(:disabled) { background: var(--wine-800); color: var(--paper); }

        .site-edit__toast {
            position: fixed;
            right: 1.5rem;
            bottom: 5.5rem;
            z-index: 50;
            display: flex;
            align-items: center;
            gap: 0.6rem;
            padding: 0.9rem 1.4rem;
            border-radius: 0.75rem;
            background: #1f7a5a;
            color: #fff;
            font-size: 0.9rem;
            box-shadow: 0 18px 40px -18px rgba(0, 0, 0, 0.45);
            opacity: 0;
            transform: translateY(12px);
            pointer-events: none;
            transition: opacity 0.3s ease, transform 0.3s ease;
        }

        .site-edit__toast--visible { opacity: 1; transform: none; }
        .site-edit__toast--error { background: #a3242a; }

        .site-edit__history {
            position: fixed;
            right: 1.5rem;
            bottom: 5.5rem;
            z-index: 40;
            width: min(26rem, calc(100vw - 3rem));
            max-height: 60vh;
            overflow-y: auto;
            background: #fff;
            border: 1px solid var(--paper-line);
            border-radius: 0.9rem;
            box-shadow: 0 24px 60px -28px rgba(0, 0, 0, 0.4);
            display: none;
        }

        .site-edit__history--open { display: block; }

        .site-edit__history h2 {
            margin: 0;
            padding: 1rem 1.25rem;
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-size: 1.15rem;
            color: var(--wine-800);
            border-bottom: 1px solid var(--paper-line);
        }

        .site-edit__revision {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.85rem 1.25rem;
            border-bottom: 1px solid var(--paper-line);
            font-size: 0.85rem;
        }

        .site-edit__revision:last-child { border-bottom: 0; }
        .site-edit__revision-meta { flex: 1; }
        .site-edit__revision-date { color: var(--ink); }
        .site-edit__revision-info { color: var(--ink-soft); font-size: 0.78rem; }

        .site-edit__revision button {
            font: inherit;
            cursor: pointer;
            padding: 0.35rem 0.9rem;
            border-radius: 1rem;
            border: 1px solid var(--wine-800);
            background: transparent;
            color: var(--wine-800);
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
        }

        .site-edit__revision button:hover { background: var(--wine-800); color: #fff; }
        .site-edit__empty { padding: 1.25rem; color: var(--ink-soft); font-size: 0.85rem; }

        .site-edit__badge {
            margin-left: 0.5rem;
            padding: 0.1rem 0.5rem;
            border-radius: 1rem;
            background: var(--paper);
            border: 1px solid var(--paper-line);
            color: var(--ink-soft);
            font-size: 0.68rem;
            letter-spacing: 0.08em;
            text-transform: uppercase;
        }
    </style>
</head>
<body>
    <div class="site-edit__bar">
        <h1 class="site-edit__title">Edycja strony</h1>
        <span class="site-edit__hint">Kliknij dowolny tekst, popraw treść, a na końcu zapisz zmiany.</span>
        <a class="site-edit__btn site-edit__btn--ghost" href="{{ path('sylius_admin_dashboard') }}">Wróć do panelu</a>
    </div>

    <iframe id="site-frame" class="site-edit__frame" src="/?edit=1" title="Podgląd strony"></iframe>

    <div class="site-edit__history" id="history">
        <h2>Historia zmian</h2>
        <div id="history-list"><p class="site-edit__empty">Wczytywanie…</p></div>
    </div>

    <div class="site-edit__toast" id="toast"></div>

    <div class="site-edit__actions">
        <span class="site-edit__status" id="status">Brak zmian do zapisania.</span>
        <button type="button" class="site-edit__btn site-edit__btn--ghost" id="history-toggle">Historia zmian</button>
        <button type="button" class="site-edit__btn site-edit__btn--ghost" id="discard" disabled>Odrzuć zmiany</button>
        <button type="button" class="site-edit__btn" id="save" disabled>Zapisz zmiany</button>
    </div>

    <script>
        const frame = document.getElementById('site-frame');
        const status = document.getElementById('status');
        const saveButton = document.getElementById('save');
        const discardButton = document.getElementById('discard');

        const setDirty = (count) => {
            const hasChanges = count > 0;
            saveButton.disabled = !hasChanges;
            discardButton.disabled = !hasChanges;
            status.textContent = hasChanges
                ? `Niezapisane zmiany: ${count}`
                : 'Brak zmian do zapisania.';
        };

        window.addEventListener('message', (event) => {
            if (event.source !== frame.contentWindow) {
                return;
            }

            const message = event.data ?? {};

            if (message.type === 'oma:dirty') {
                setDirty(message.count ?? 0);
            }

            if (message.type === 'oma:saved') {
                status.textContent = message.ok ? 'Zapisano zmiany.' : 'Nie udało się zapisać zmian.';
                saveButton.disabled = message.ok;
                discardButton.disabled = message.ok;
                showToast(message.ok ? 'Zapisano zmiany' : 'Nie udało się zapisać zmian', !message.ok);

                if (message.ok && history.classList.contains('site-edit__history--open')) {
                    void loadHistory();
                }
            }
        });

        saveButton.addEventListener('click', () => {
            status.textContent = 'Zapisywanie…';
            frame.contentWindow.postMessage({ type: 'oma:save' }, window.location.origin);
        });

        discardButton.addEventListener('click', () => {
            frame.contentWindow.postMessage({ type: 'oma:discard' }, window.location.origin);
        });

        const toast = document.getElementById('toast');
        const history = document.getElementById('history');
        const historyList = document.getElementById('history-list');
        let toastTimer;

        const showToast = (message, isError = false) => {
            toast.textContent = message;
            toast.classList.toggle('site-edit__toast--error', isError);
            toast.classList.add('site-edit__toast--visible');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(() => toast.classList.remove('site-edit__toast--visible'), 3500);
        };

        const loadHistory = async () => {
            const response = await fetch('/admin/site/revisions', { credentials: 'include' });

            if (!response.ok) {
                historyList.innerHTML = '<p class="site-edit__empty">Nie udało się wczytać historii.</p>';
                return;
            }

            const { revisions } = await response.json();

            if (!revisions.length) {
                historyList.innerHTML = '<p class="site-edit__empty">Brak zapisanych wersji. Pierwsza powstanie po zapisaniu zmian.</p>';
                return;
            }

            historyList.innerHTML = revisions.map((revision, index) => `
                <div class="site-edit__revision">
                    <div class="site-edit__revision-meta">
                        <div class="site-edit__revision-date">
                            ${revision.createdAt}
                            ${index === 0 ? '<span class="site-edit__badge">wersja aktualna</span>' : ''}
                        </div>
                        <div class="site-edit__revision-info">
                            ${revision.reason === 'restore' ? 'przywrócenie' : 'edycja'} ·
                            ${revision.author} ·
                            zmienionych pól: ${revision.changedKeys.length}
                        </div>
                    </div>
                    ${index === 0 ? '' : `<button type="button" data-restore="${revision.id}">Przywróć</button>`}
                </div>
            `).join('');
        };

        document.getElementById('history-toggle').addEventListener('click', () => {
            history.classList.toggle('site-edit__history--open');

            if (history.classList.contains('site-edit__history--open')) {
                void loadHistory();
            }
        });

        historyList.addEventListener('click', async (event) => {
            const button = event.target.closest('[data-restore]');

            if (!button) {
                return;
            }

            button.disabled = true;
            const response = await fetch(`/admin/site/revisions/${button.dataset.restore}/restore`, {
                method: 'POST',
                credentials: 'include',
            });
            button.disabled = false;

            if (!response.ok) {
                showToast('Nie udało się przywrócić wersji.', true);
                return;
            }

            const { restored, message } = await response.json();

            if (restored === 0) {
                showToast(message ?? 'Nic się nie zmieniło.', true);
                return;
            }

            showToast(`Przywrócono wersję strony (zmienionych pól: ${restored}).`);
            frame.contentWindow.location.reload();
            void loadHistory();
        });
    </script>
</body>
</html>
