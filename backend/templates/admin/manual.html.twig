<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Instrukcja obsługi panelu — OMA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500&family=Jost:wght@300;400;500&display=swap" rel="stylesheet">
    <style>
        :root {
            --wine-800: #5a1f2c;
            --paper: #f4f3f0;
            --paper-line: #dcd9d4;
            --ink: #2a2320;
            --ink-soft: #6f6259;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            background: var(--paper);
            color: var(--ink);
            font-family: 'Jost', 'Helvetica Neue', Arial, sans-serif;
            font-weight: 300;
            display: flex;
            flex-direction: column;
            min-height: 100vh;
        }

        .manual__bar {
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 1rem;
            padding: 0.9rem 1.5rem;
            background: #fff;
            border-bottom: 1px solid var(--paper-line);
        }

        .manual__title {
            font-family: 'Cormorant Garamond', Georgia, serif;
            font-size: 1.4rem;
            color: var(--wine-800);
            margin: 0;
        }

        .manual__hint {
            font-size: 0.78rem;
            color: var(--ink-soft);
        }

        .manual__actions {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .manual__btn {
            font: inherit;
            cursor: pointer;
            text-decoration: none;
            padding: 0.5rem 1.25rem;
            border-radius: 2rem;
            border: 1px solid var(--wine-800);
            background: var(--wine-800);
            color: #fff;
            font-size: 0.72rem;
            letter-spacing: 0.12em;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .manual__btn--ghost {
            background: transparent;
            color: var(--wine-800);
        }

        .manual__btn:hover { opacity: 0.85; }

        .manual__frame {
            flex: 1;
            width: 100%;
            border: 0;
            background: var(--paper);
        }
    </style>
</head>
<body>
    <div class="manual__bar">
        <h1 class="manual__title">Instrukcja obsługi panelu</h1>
        <span class="manual__hint">Przewijaj strzałkami lub kółkiem myszy. Spis treści jest na drugiej stronie.</span>
        <div class="manual__actions">
            <a class="manual__btn manual__btn--ghost" href="{{ path('sylius_admin_dashboard') }}">Wróć do panelu</a>
            <a class="manual__btn" href="{{ path('oma_admin_manual_pdf') }}" download>Pobierz PDF</a>
        </div>
    </div>

    <iframe class="manual__frame" src="{{ path('oma_admin_manual_pdf') }}" title="Instrukcja obsługi panelu"></iframe>
</body>
</html>
