#!/bin/sh
set -u

SLUG="${1:?podaj slug zadania}"
shift

SENTRY_SCHEDULE=""
case "${1:-}" in
    *' '*) SENTRY_SCHEDULE="$1"; shift ;;
esac

OUTPUT="$(mktemp)"
trap 'rm -f "$OUTPUT"' EXIT

random_uuid() {
    if [ -r /proc/sys/kernel/random/uuid ]; then
        cat /proc/sys/kernel/random/uuid
        return 0
    fi

    od -An -tx1 -N16 /dev/urandom | tr -d ' \n' | awk '{
        printf "%s-%s-4%s-a%s-%s", substr($0,1,8), substr($0,9,4), substr($0,14,3), substr($0,18,3), substr($0,21,12)
    }'
}

CHECK_IN_ID="$(random_uuid)"

healthchecks_ping() {
    if [ -z "${HEALTHCHECKS_PING_URL:-}" ]; then
        return 0
    fi

    if ! curl -fsS -m 10 --retry 3 -o /dev/null \
        --data-binary "@$OUTPUT" \
        "${HEALTHCHECKS_PING_URL}/${SLUG}${1}?create=1"; then
        echo "oma-cron: ping ${SLUG}${1} nie doszedl do Healthchecks" >&2
    fi
}

sentry_url() {
    scheme="$(printf '%s' "$SENTRY_DSN" | sed -n 's#^\(https\{0,1\}\)://.*#\1#p')"
    key="$(printf '%s' "$SENTRY_DSN" | sed -n 's#^https\{0,1\}://\([^@]*\)@.*#\1#p')"
    host="$(printf '%s' "$SENTRY_DSN" | sed -n 's#^https\{0,1\}://[^@]*@\([^/]*\)/.*#\1#p')"
    project="$(printf '%s' "$SENTRY_DSN" | sed -n 's#.*/\([0-9]\{1,\}\)$#\1#p')"

    if [ -z "$scheme" ] || [ -z "$key" ] || [ -z "$host" ] || [ -z "$project" ]; then
        return 1
    fi

    printf '%s://%s/api/%s/cron/%s/%s/' "$scheme" "$host" "$project" "$SLUG" "$key"
}

sentry_check_in() {
    if [ -z "${SENTRY_DSN:-}" ]; then
        return 0
    fi

    url="$(sentry_url)" || {
        echo "oma-cron: nie umiem zlozyc adresu Sentry z SENTRY_DSN" >&2
        return 0
    }

    if [ "$1" = 'in_progress' ] && [ -n "$SENTRY_SCHEDULE" ]; then
        body="$(printf '{"check_in_id":"%s","status":"in_progress","monitor_config":{"schedule":{"type":"crontab","value":"%s"},"timezone":"%s","checkin_margin":%s,"max_runtime":%s}}' \
            "$CHECK_IN_ID" "$SENTRY_SCHEDULE" "${OMA_HC_TZ:-Europe/Warsaw}" \
            "${OMA_SENTRY_CHECKIN_MARGIN:-10}" "${OMA_SENTRY_MAX_RUNTIME:-30}")"
    else
        body="$(printf '{"check_in_id":"%s","status":"%s"}' "$CHECK_IN_ID" "$1")"
    fi

    if ! curl -fsS -m 10 --retry 3 -o /dev/null \
        -X POST -H 'Content-Type: application/json' \
        --data "$body" "$url"; then
        echo "oma-cron: check-in ${SLUG} (${1}) nie doszedl do Sentry" >&2
    fi
}

healthchecks_ping /start
sentry_check_in in_progress

set +e
"$@" >"$OUTPUT" 2>&1
STATUS=$?
set -e

cat "$OUTPUT"

healthchecks_ping "/${STATUS}"

if [ "$STATUS" -eq 0 ]; then
    sentry_check_in ok
else
    sentry_check_in error
fi

exit "$STATUS"
